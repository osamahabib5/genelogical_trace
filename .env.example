# ============================================================
# Genealogy Traceline — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ---- Supabase PostgreSQL Connection ----
# Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Session pooler" URI (port 5432) for the backend.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# ---- LLM Provider ----
# Primary: deepseek   Secondary: groq
LLM_PROVIDER=deepseek

# ---- Document upload pipeline ----
# false = direct regex pipeline + Ollama embeddings (fast, no LLM calls on upload)
# true  = DeepSeek-powered agentic cleaning
USE_AGENT_PROCESSING=false

# DeepSeek (primary)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Groq (secondary / fallback)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# ---- Embeddings ----
# DeepSeek and Groq are chat-only APIs; embeddings use local Ollama by default.
# Alternatives: EMBEDDING_PROVIDER=openai or EMBEDDING_PROVIDER=azure-foundry
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Texts per embedding HTTP request. Larger batches (256/512) mean fewer
# requests and less per-request overhead, but a failed request loses the
# whole batch.
EMBED_BATCH_SIZE=128
# OpenAI is optional (1536-dim embeddings) if you switch EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Frontend ----
REACT_APP_API_URL=http://localhost:8000
